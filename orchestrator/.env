# ══════════════════════════════════════════════════════════
# Agentic 5G QoS Orchestrator — Environment Configuration
# ══════════════════════════════════════════════════════════
# Copy this file and fill in your credentials:
#   cp .env.example .env
# Then load before running:
#   export $(cat .env | xargs) && python3 main.py

# ── LLM Backend — Ollama (local) ────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=300

# ── Groq API (disabled — quota exhausted; kept for reference) ─
# GROQ_API_KEY=
# LLM_MODEL=llama-3.1-8b-instant

# ── 5G Network SLA Thresholds ─────────────────────────────
URLLC_RTT_SLA_MS=20.0
EMBB_MIN_THROUGHPUT_MBPS=20.0
MMTC_MIN_PDR=0.995

# ── eMBB Bandwidth Control ────────────────────────────────
EMBB_RATE_MAX_MBIT=1000
EMBB_RATE_FLOOR_MBIT=50
EMBB_INTERFACE=ogstun-embb

# ── Network Nodes ─────────────────────────────────────────
WORKER_SSH_USER=kube
WORKER_SSH_HOST=192.168.49.172
WORKER_SSH_KEY=/home/kube-master/.ssh/id_rsa

UERANSIM_SSH_USER=shinegami
UERANSIM_SSH_HOST=192.168.49.139
UERANSIM_SSH_PASS=123

# ── Orchestrator Control Loop ─────────────────────────────
LOOP_INTERVAL_SEC=0
MEMORY_SIZE=10
METRICS_PORT=9200

# ── Prometheus ────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:30090
