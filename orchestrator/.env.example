# ══════════════════════════════════════════════════════════
# Agentic 5G QoS Orchestrator — Environment Configuration
# ══════════════════════════════════════════════════════════
# Copy this file and fill in your credentials:
#   cp .env.example .env
# Then load before running:
#   export $(cat .env | xargs) && python3 main.py

# ── Groq LLM API ──────────────────────────────────────────
# Get free key at: https://console.groq.com
# Free tier: 30 req/min, 14,400 req/day (enough for 3s loop)
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Model Selection ───────────────────────────────────
# Options (Groq-hosted):
#   llama-3.3-70b-versatile   ← recommended (best reasoning)
#   llama-3.1-8b-instant      ← faster, lower latency
#   mixtral-8x7b-32768        ← good for structured JSON output
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# ── 5G Network SLA Thresholds ─────────────────────────────
URLLC_RTT_SLA_MS=15.0
EMBB_MIN_THROUGHPUT_MBPS=20.0
MMTC_MIN_PDR=0.995

# ── eMBB Bandwidth Control ────────────────────────────────
EMBB_RATE_MAX_MBIT=1000
EMBB_RATE_FLOOR_MBIT=50
EMBB_INTERFACE=ogstun-embb

# ── Network Nodes ─────────────────────────────────────────
WORKER_SSH_USER=kube
WORKER_SSH_HOST=192.168.49.171
WORKER_SSH_KEY=/root/.ssh/id_rsa

UERANSIM_SSH_USER=shinegami
UERANSIM_SSH_HOST=192.168.49.139
UERANSIM_SSH_PASS=123

# ── Orchestrator Control Loop ─────────────────────────────
LOOP_INTERVAL_SEC=3
MEMORY_SIZE=10
METRICS_PORT=9200

# ── Prometheus ────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:30090
